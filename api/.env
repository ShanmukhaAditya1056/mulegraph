PORT=5000

# PostgreSQL Configuration
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=mulegraph
PG_PASSWORD=password
PG_PORT=5432

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Firebase Configuration
FIREBASE_PROJECT_ID=mulegraph-ai
# Provide path to your serviceAccountKey.json when ready
FIREBASE_CREDENTIALS_PATH=./config/serviceAccountKey.json
